# GSE Terminal configuration.
#
#   cp .env.example .env
#
# Values below are the defaults the server applies when a variable is unset.
# The seven marked REQUIRED have no default — the server exits at boot
# listing every one that is missing.

# ---------------------------------------------------------------- core ---
# development: assets re-read from ui/dist per request, cookies not Secure.
# production:  assets from the embedded snapshot, cookies require HTTPS,
#              and JWT_SECRET must be at least 32 characters.
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# REQUIRED. openssl rand -hex 32
JWT_SECRET=

# REQUIRED. Comma-separated. The browser refuses the WebSocket without it.
# Local: http://localhost:8080   Production: https://your.domain
ALLOWED_ORIGINS=http://localhost:8080

# ------------------------------------------------------------ postgres ---
# Host/port are for `go run` on the host; compose overrides them with the
# service name. User/password/db are read by the postgres container too.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# REQUIRED (all three).
# Change POSTGRES_PASSWORD for any real deploy.
POSTGRES_USER=gse
POSTGRES_PASSWORD=
POSTGRES_DB=gse

# ------------------------------------------------------- questdb, redis ---
# Host-side endpoints; compose substitutes questdb:8812 / questdb:9009 /
# redis:6379 inside the network.
# REQUIRED (both).
QUESTDB_URL=postgres://admin:quest@localhost:8812/qdb
QUESTDB_ILP_TCP_URL=localhost:9009
REDIS_URL=localhost:6379

# ------------------------------------------------- production / caddy ---
# Both are consumed by docker-compose.prod.yaml and hard-fail if unset when
# the production overlay is used. APP_DOMAIN drives the TLS certificate.
APP_DOMAIN=
ACME_EMAIL=

# Used for links in alert emails, and as the OAuth base.
APP_BASE_URL=http://localhost:8080

# Set true only behind a reverse proxy you control, so X-Forwarded-For and
# X-Real-IP are trusted for rate limiting and the audit log.
TRUST_PROXY=false

# ------------------------------------------------------------- ai / llm ---
# All optional. Providers are tried in order, so one being rate limited does
# not take the feature down. With none set, the oracle falls back to
# heuristic commentary.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint: Ollama, vLLM, OpenRouter, Groq, LiteLLM.
# BASE_URL enables it; the key is optional for unauthenticated local servers.
# MODEL is mandatory when BASE_URL is set — there is no default to fall back
# on. NAME only labels the provider in logs.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_NAME=

HTTP_TIMEOUT_SECONDS=10

# ------------------------------------------------------ google oauth ---
# Optional. Omit entirely to leave password login as the only path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# ------------------------------------------------------------- email ---
# Optional. Without these, alerts are delivered in-app and by Web Push only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# -------------------------------------------------------- web push ---
# Optional. Generate a VAPID keypair to enable browser push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional. Comma-separated hosts the server will deliver push notifications
# to. The endpoint in a subscription is a URL the server POSTs to, so it is
# restricted to real push services; leaving this empty uses the built-in list
# covering Chrome, Firefox, Safari and legacy Edge. Set it only to admit a
# browser whose push service is not on that list. An entry beginning with a
# dot matches that domain and its subdomains.
WEBPUSH_ALLOWED_HOSTS=

# ------------------------------------------------------- operations ---
# Guards /metrics. openssl rand -hex 32, or leave empty to disable it.
METRICS_TOKEN=

# Opt-in authenticated, read-only Model Context Protocol endpoint at POST /mcp.
# MCP clients must use an existing session cookie or API key. Keep disabled
# until you have configured the clients permitted to access your deployment.
MCP_ENABLED=false

# Empty logs to stdout only, which is what you want under compose. When set,
# logs are written to that file *in addition to* stdout, with rotation.
LOG_FILE=

# "json" or "text".
LOG_FORMAT=text

# Rotation for LOG_FILE, applied by lumberjack. Ignored entirely when
# LOG_FILE is empty; rotated files are gzip-compressed.
# Megabytes a log may reach before it is rotated.
LOG_MAX_SIZE=10
# How many rotated files to keep.
LOG_MAX_BACKUPS=3
# How many days a rotated file is kept.
LOG_MAX_AGE=28

# The daily scrape shells out to this script via the chrome-agent CLI.
#
# This must be an ABSOLUTE path. The Dockerfile sets it to
# /app/scripts/gse_download.py, but compose loads this file with `env_file`,
# and env_file overrides the image's own ENV -- so whatever is written here
# wins inside the container. A relative path resolves against the container's
# working directory (/), not the repo, and the collector then logs
# "Automated GSE scrape disabled: download script not found" and never runs
# again. That warning is the only symptom: the app stays healthy and serves
# normally while silently ingesting nothing.
#
# For `go run` from a checkout, use scripts/gse_download.py instead.
GSE_DOWNLOAD_SCRIPT=/app/scripts/gse_download.py
GSE_PYTHON_BIN=python3
